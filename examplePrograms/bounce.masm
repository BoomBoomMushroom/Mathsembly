; An example program to show off the display
# 0x0E1970

; REG_0I  = Ball X
; REG_1I  = Ball Y
; REG_2I  = Ball Velocity X
; REG_3I  = Ball Velocity Y
; REG_4I  = Ball Color
; REG_5I  = Frame Number

!INIT
    COPY 128 REG_0I ; x
    COPY 128 REG_1I ; y
    COPY 3 REG_2I ; vx
    COPY -6 REG_3I ; vy

!INIT_VIDEO
    ; Set up the video Settings
    ;   write the video memory settings, 256x256, 8bpp
    COPY 0x000960 ADDR ; the address for the first byte of video settings
    CLTB 0b01000000 REG_M ; top 8 bits of the width param
    ADD ADDR 1 ADDR ; ADDR = ADDR + 1
    CLTB 0b00100000 REG_M ; the final 2 bits of the width param and then the top 6 bits of the height
    ADD ADDR 1 ADDR
    CLTB 0b00001000 REG_M ; the final 3 bits of the height and the 5 bits for the bit depth (bpp)

!LOOP
    COPY 0x00 REG_4I ; clear the ball; do this by making it black
    PUSH MOVE_BALL ; addr to return
    JMP DRAW_BALL ; enter into our subroutine
!MOVE_BALL
    ADD REG_0I REG_2I REG_0I; x += vx
    ADD REG_1I REG_3I REG_1I; y += vy

    PUSH CALL_DRAW_WHITE ; return addr
    JMP CHECK_BOUNDS
!CALL_DRAW_WHITE
    COPY 0xFF REG_4I ; draw the ball in white
    PUSH DISPLAY
    JMP DRAW_BALL
!DISPLAY
    ADD REG_5I 1 REG_5I ; frameNum += 1
    SHOW ; display the screen
    JMP LOOP


!DRAW_BALL
    ; REG_5I is the ball pixel address
    COPY 0x000970 REG_5I ; set it to the start video memory address
    
    MOVE ZERO REG_0F ; to calculate the y index
    COPY 256.0 REG_1F; to multiply y value
        ; also multiply it by the bytes per pixel, but it is 1 here so i'm not doing it
    MULT REG_1I REG_1F REG_0F ; yi = 256 * y
    
    ADD REG_5I REG_0I REG_5I ; a += x
    ADD REG_5I REG_0F REG_5I ; a += yi (or a += y*256)
    ; now we have the address inside of REG_5I
    MOVE REG_5I ADDR ; set the working address to the ball pixel
    CLTB REG_4I REG_M ; copy the low byte of the ball's color (REG_4I) to the video pixel
    POP PC ; return from this subroutine

!CHECK_BOUNDS
    !CHECK_BOUNDS_X
        SUB 256 REG_0I ZERO ; 256-X | If to the right of the bounds negative flag will be true
        JMN FLIP_VX
        SUB REG_0I 0 ZERO ; X-0 | If to the left of the bounds negative flag will be true
        JMN FLIP_VX
        JMP CHECK_BOUNDS_Y
    !CHECK_BOUNDS_Y
        SUB 256 REG_1I ZERO ; 256-Y | If below the bottom bounds, the negative flag will be true
        JMN FLIP_VY
        SUB REG_1I 0 ZERO ; Y-0 | If above the top bounds, the negative flag will be true
        JMN FLIP_VY
        JMP CHECK_BOUNDS_RETURN
    !CHECK_BOUNDS_RETURN
        POP PC ; return from this subroutine

    !FLIP_VX
        MULT REG_2I -1 REG_2I ; vx *= -1
        JMP CHECK_BOUNDS_Y
    !FLIP_VY
        MULT REG_3I -1 REG_3I ; vy *= -1
        JMP CHECK_BOUNDS_RETURN



