; An example program to show off the display
# 0x0E1970

; REG_0I = loop counter
; REG_28I = The address to jump to after setting all of the video pixels
; REG_29I = Start of our loop
; REG_30I = Start of video memory
; REG_31I = End of video memory
SET REG_28I 0x0E1A30
SET REG_29I 0x0E1A00
SET REG_30I 0x000970
SET REG_31I 0x0E196F

; Set up the video Settings
;   write the video memory settings, 640x480, 24bpp
SET ADDR 0x000960 ; the address for the first byte of video settings
SETB REG_M 0b10100000 ; top 8 bits of the width param
ADD ADDR 1 ADDR ; ADDR = ADDR + 1
SETB REG_M 0b00111100 ; the final 2 bits of the width param and then the top 6 bits of the height
ADD ADDR 1 ADDR
SETB REG_M 0b00011000 ; the final 3 bits of the height and the 5 bits for the bit depth (bpp)

SET REG_0I 0 ; set our counter to 0
COPY REG_30I ADDR

# 0x0E1A00 ; set where our loop will live in memory
ADD REG_0I 1 REG_0I ; increment our counter, this is for our shifting our color over the space
; since our cltb copies just the least significant byte we don't need to AND it w/ 0xFF
CLTB REG_0I REG_M ; copies the lsB of our counter into the video memory byte
ADD ADDR 1 ADDR ; increment our address in video memory to write the next byte

SUB ADDR REG_31I ZERO ; basically CMP, do a subtract and write it into the zero reg (to discard it) but it'll update our flags, then we can do jumps
JMZ REG_28I ; if we've hit the end of the video memory then break out of our loop
COPY REG_29I PC ; loop again


# 0x0E1A30 ; after our loop is done jump here
SHOW ; draw the screen
ADD REG_0I 1 REG_0I ; increment the counter to offset the color for the next frame
COPY REG_29I PC

